SIMULATOR=mock
# Set to your local Uno USB port to enable hardware control.
# ARDUINO_PORT=COM3

# Defaults permit circuitgaurd.vercel.app and this project's deployment URLs.
# Optional override for a different Vercel project:
# CORS_ORIGIN_REGEX=^https://circuitgaurd-[a-z0-9-]+-gatorhacks-vivi\.vercel\.app$

# Optional Gemini explanations; keep actual keys in the ignored local .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_TIMEOUT_SECONDS=20
